{
  "name": "@noice-tech/demo-recorder-remotion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "cd ../.. && remotion studio apps/remotion/src/index.ts --config=apps/remotion/remotion.config.ts"
  },
  "dependencies": {
    "@noice-tech/demo-recorder-core": "workspace:*",
    "@remotion/cli": "4.0.493",
    "@remotion/media": "4.0.493",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.493",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
