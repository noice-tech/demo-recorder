{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "package": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "assets/**"]
    },
    "studio": {
      "cache": false,
      "persistent": true
    }
  }
}
