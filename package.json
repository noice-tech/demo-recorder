{
  "name": "@noice-tech/demo-recorder-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt . --ignore-path=.oxfmtignore",
    "format:check": "oxfmt . --check --ignore-path=.oxfmtignore",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:renderer": "vitest run --config vitest.integration.config.ts packages/ffmpeg-renderer/tests/render.integration.test.ts",
    "test:package": "pnpm package:cli && tsx scripts/package-smoke.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "tsx scripts/clean.ts",
    "package:cli": "turbo run package --filter=@noice-tech/demo-recorder",
    "demo-recorder": "pnpm --filter @noice-tech/demo-recorder exec tsx src/index.ts",
    "demo:explore": "pnpm demo-recorder explore",
    "demo:record": "pnpm --filter @noice-tech/demo-recorder record",
    "demo:render": "pnpm package:cli && pnpm --filter @noice-tech/demo-recorder render"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "playwright": "1.62.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
